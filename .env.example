#--------------------------------------------------------------------
# E-Repository — contoh .env untuk PRODUKSI
# Salin menjadi ".env" (di folder root aplikasi, SEJAJAR dengan app/, bukan di public/),
# lalu isi nilai sesuai hosting Anda. JANGAN commit / unggah .env ke tempat publik.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Harus diakhiri garis miring. Gunakan https:// bila SSL sudah aktif.
app.baseURL = 'https://repository.contoh.ac.id/'

# Aktifkan setelah HTTPS berjalan: memaksa HTTPS + HSTS.
app.forceGlobalSecureRequests = true

# Cookie sesi hanya dikirim lewat HTTPS (aktifkan bersama baris di atas).
cookie.secure = true

# Bila situs berada di belakang Cloudflare/reverse-proxy, isi IP proxy agar IP pengguna
# (dipakai login throttle & log) terbaca benar. Contoh (JSON):
# app.proxyIPs = {'172.16.0.0/12': 'X-Forwarded-For'}

#--------------------------------------------------------------------
# DATABASE (MySQL / MariaDB)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = nama_database
database.default.username = user_database
database.default.password = 'password_database'
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# PENGATURAN E-REPOSITORY
#--------------------------------------------------------------------
repository.appName = 'E-Repository'
repository.institution = 'Nama Institusi Anda'

# Login throttle
repository.maxAttemptsPerAccount = 5
repository.maxAttemptsPerIdentifier = 15
repository.maxAttemptsPerIp = 20
repository.lockMinutes = 15

# Captcha "Saya bukan robot": builtin | recaptcha | turnstile
repository.captchaDriver = builtin
# repository.captchaSiteKey = ''
# repository.captchaSecretKey = ''

# Batas ukuran unggah per berkas (KB). Harus <= upload_max_filesize di hosting.
repository.maxUploadKb = 20480

#--------------------------------------------------------------------
# PEMINDAI VIRUS  (auto | clamav | builtin | off)  — lihat README
#--------------------------------------------------------------------
# auto   : heuristik + ClamAV bila terdeteksi (disarankan untuk shared hosting)
# clamav : ClamAV WAJIB, unggahan ditolak bila ClamAV tidak tersedia
repository.scanMode = auto
# clamd di server lain (VPS). Batasi port 3310 dengan firewall hanya untuk IP hosting Anda!
# repository.clamdHost = '203.0.113.10'
# repository.clamdPort = 3310
# clamd lokal lewat socket Unix (kosong = auto-deteksi lokasi umum)
# repository.clamdSocket = '/var/run/clamav/clamd.ctl'
repository.scanTimeout = 60
